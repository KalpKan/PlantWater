# Plant It — names only. Real values live in Vercel (project "plantit", Settings → Environment Variables).
# Local dev: copy to .env (API, read by backend/src/index.js) and put the REACT_APP_* lines in frontend/.env.local.

# Firebase Admin (project plant-it-5e2fc, Spark plan). From a service-account JSON: project_id, client_email, private_key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional; defaults to https://<project>-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Supabase Storage for plant photos (Project B "platform", bucket plantit-photos). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=plantit-photos

# Paid providers (optional: without them the app uses the bundled demo plants)
PLANTNET_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-day caps enforced by a Firestore counter (default 50 each)
PLANTNET_DAILY_LIMIT=50
OPENAI_DAILY_LIMIT=50

# Extra browser origins allowed to call the API (comma-separated). Same-origin needs nothing.
CORS_ORIGINS=
# Only for a locally-run API on your home Wi-Fi, e.g. 192.168.1. (with the trailing dot)
DEVICE_DISCOVERY_SUBNET=

# Frontend (build-time; CRA only exposes REACT_APP_*)
REACT_APP_API_URL=
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=/ingest
